# Secrets: never committed. Copy .env.example to .env and fill it in locally.
.env
.env.*
!.env.example

# Environments and caches
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.sqlfluff_cache/

# Generated by make_data.py and the pipeline: rebuild them, never commit them
data/
*.duckdb
*.duckdb.wal
out/
reports/

# dbt (capstone)
target/
dbt_packages/
logs/
.user.yml

# Claude Code: personal files and worktrees
/.claude/settings.local.json
/.claude/worktrees/
# ...but the chapter solutions show one; Claude Code's global git excludes would hide it
!/chapters/**/.claude/settings.local.json

# OS
Thumbs.db
desktop.ini
.DS_Store
