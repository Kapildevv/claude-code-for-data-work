{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "plansDirectory": "./.claude/plans",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(uv run python .claude/skills/profile-data/scripts/dq_profile.py)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(uv run python .claude/skills/profile-data/scripts/dq_profile.py)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./data/raw/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_raw.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lint_sql.py\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/log_tools.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
